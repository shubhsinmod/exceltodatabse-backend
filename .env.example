# ==============================================================================
# DATABASE CONFIGURATION (Internal Session & History Tracker)
# ==============================================================================
# 1. SQLite (Default - Recommended for Local & Render Free Tier / Serverless)
#    Zero installation, automatically creates 'restaurant.db' in backend root
DATABASE_URL=sqlite:///./restaurant.db

# 2. PostgreSQL (e.g., Render Managed Postgres, Supabase, Neon, AWS RDS)
# DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# 3. MySQL (Requires pymysql driver)
# DATABASE_URL=mysql+pymysql://username:password@hostname:3306/database_name

# 4. Microsoft SQL Server (Requires pyodbc driver)
# DATABASE_URL=mssql+pyodbc://username:password@hostname:1433/database_name?driver=ODBC+Driver+17+for+SQL+Server

# ==============================================================================
# FILE STORAGE CONFIGURATION
# ==============================================================================
UPLOAD_DIR=uploads

# ==============================================================================
# SQL GENERATION CONFIGURATION
# ==============================================================================
SQL_DIALECT=tsql
SQL_INSERT_BATCH_SIZE=1000

# ==============================================================================
# GROQ LLM CONFIGURATION (Fallback Semantic Mapping)
# ==============================================================================
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

AUTO_ACCEPT_CONFIDENCE=0.90
WARNING_CONFIDENCE=0.70
ENABLE_LLM_CACHE=True
